{
  "name": "notebook",
  "version": "0.1.0",
  "description": "Small SPA + Bun server that turns a flat directory of <type>-<slug>.md files into a live, WYSIWYG-edited notebook.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/jbowen1/notebook.git"
  },
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --hot run server.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/markdown": "^1.6.3",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.13"
  }
}
